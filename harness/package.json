{
  "name": "cross-chain-settlement-lab-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:imports": "node src/check-imports.ts",
    "test:encoding": "node --test --test-concurrency=1 src/tests/protocol-encoding.test.ts",
    "test:source-order": "node --test --test-concurrency=1 --test-isolation=none src/tests/source-order.test.ts",
    "test:source-cancellation": "node --test --test-concurrency=1 --test-isolation=none src/tests/source-cancellation.test.ts",
    "test:terminal-observation-live": "node --test --test-concurrency=1 --test-isolation=none src/tests/terminal-observation-live.test.ts",
    "test:terminal-observation": "node --test --test-concurrency=1 --test-isolation=none src/tests/terminal-observation.test.ts",
    "test:evm-deployment": "node --test --test-concurrency=1 src/tests/evm-deployment.test.ts",
    "test:solana-configuration": "node --test --test-concurrency=1 src/tests/solana-configuration.test.ts",
    "test:solana-deployment": "node --test --test-concurrency=1 --test-isolation=none src/tests/solana-deployment.test.ts",
    "test:dual-chain-setup": "node --test --test-concurrency=1 --test-isolation=none src/tests/dual-chain-setup.test.ts",
    "test:cancelled-delivery": "node --test --test-concurrency=1 --test-isolation=none src/tests/cancelled-delivery.test.ts",
    "test:cancelled-delivery-live": "node --test --test-concurrency=1 --test-isolation=none src/tests/cancelled-delivery-live.test.ts",
    "test:filled-delivery": "node --test --test-concurrency=1 --test-isolation=none src/tests/filled-delivery.test.ts",
    "test:cancellation-forwarding-live": "node --test --test-concurrency=1 --test-isolation=none src/tests/cancellation-forwarding-live.test.ts",
    "test:cancellation-forwarding": "node --test --test-concurrency=1 --test-isolation=none src/tests/cancellation-forwarding.test.ts",
    "test:order-forwarding": "node --test --test-concurrency=1 --test-isolation=none src/tests/order-forwarding.test.ts",
    "test:initialization": "node --test --test-concurrency=1 src/tests/initialization.test.ts",
    "test:orders": "node --test --test-concurrency=1 src/tests/order-creation.test.ts",
    "test:cancellation": "node --test --test-concurrency=1 src/tests/order-cancellation.test.ts",
    "test:cancelled": "node --test --test-concurrency=1 src/tests/cancelled-settlement.test.ts",
    "test:filled": "node --test --test-concurrency=1 src/tests/filled-settlement.test.ts",
    "test:filled-rollback:prepare": "node --test --test-concurrency=1 src/tests/filled-rollback.test.ts",
    "test:filled-rollback:verify": "node --test --test-concurrency=1 src/tests/filled-rollback.test.ts",
    "test:cancelled-rollback:prepare": "node --test --test-concurrency=1 src/tests/cancelled-rollback.test.ts",
    "test:cancelled-rollback:verify": "node --test --test-concurrency=1 src/tests/cancelled-rollback.test.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "ethers": "6.16.0"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
